# ---------- 依赖与构建产物：体积大、可重装/可重打，不进仓库 ----------
# node_modules 522MB、dist 169MB（两个 ~88MB 的安装包），提交上去仓库就废了。
# 装机包给同事用 → 走 GitHub Releases / 网盘，不要塞进 git 历史（历史里的二进制删不干净）。
node_modules/
dist/
dist-new/
out/
*.log

# ---------- 应用运行时数据 ----------
# 正常情况下它们在 %APPDATA%\dewu-bluev-publisher（userData），不在仓库里；
# 这里再兜一层，避免有人把输出目录指到工程内之后误提交。
auth.json
auth.seed.json
config.json
project.json
pending-results.json
publish-log.jsonl
dumps/
batches/
failures/
素材/
输出/
_rejected/

# ---------- 发布凭据：绝不进仓库 ----------
# 对象存储的子账号密钥只该躺在打包机上。上传脚本读环境变量或这两个文件。
# 进过 git 的密钥等于公开 —— 一旦误提交，必须去 CAM 里把这对密钥删掉重发，改文件没用。
.env
.env.local

# ---------- 代码快照（回滚点，按约定放在工程外） ----------
_snapshot-*.tar.gz

# ---------- 定点破坏验证留下的备份：正常跑完会自己删掉，留在这里就说明脚本崩在半路 ----------
*.fixbak
*.brandbak
*.updbak

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
